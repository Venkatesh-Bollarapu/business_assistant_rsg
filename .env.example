# Copy this file to .env and fill in your values. NEVER commit .env.

# --- LLM (Groq via LangChain) ---------------------------------------------
# Get a free key at https://console.groq.com/keys
# Leave empty to run with the built-in rule-based interpreter (no LLM).
GROQ_API_KEY=groq_api_key_here
# Any Groq chat model that supports tool calling. Alternatives: openai/gpt-oss-20b
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20

# --- Data -------------------------------------------------------------------
DATABASE_PATH=data/bi_assistant.db
DATA_CSV_PATH=data/sales_data.csv

# --- App --------------------------------------------------------------------
LOG_LEVEL=INFO
# Used by the Streamlit frontend to reach the API
API_URL=http://127.0.0.1:8000
